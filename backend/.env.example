# Server Port
PORT=3001
NODE_ENV=production

# Supabase PostgreSQL Configuration
# (Found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Secret token required by scheduled cron requests (cron-job.org)
# Header: x-cron-secret: <CRON_SECRET> or Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-strong-random-secret-here

# Target Mock Store URL
MOCK_STORE_URL=https://demo.inelabteamdev.com
