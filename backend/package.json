{
  "name": "price-tracker-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend service and scraper engine for Product Price Tracker",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "npx playwright install chromium",
    "scrape:headed": "node src/scripts/runScraperHeaded.js",
    "scrape:headless": "node src/scripts/runScraperHeadless.js",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "playwright": "^1.50.1"
  }
}
